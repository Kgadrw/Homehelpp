# Copy to .env and fill in real values. Never commit .env.

# ── App ──────────────────────────────────────────────────────
SITE_NAME=Home Help
SITE_URL=https://homehelp.rw
# BASE_URL=https://homehelp.rw

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://homehelp.rw/google-login

# ── WhatsApp ─────────────────────────────────────────────────
WA_TOKEN=
WA_PHONE_ID=
WA_API_ME_TOKEN=
ADMIN_WHATSAPP=250790533144

# ── SMTP / Email ─────────────────────────────────────────────
# Primary domain mailbox (SSL 465). Auth failures auto-fall back to Gmail below.
SMTP_HOST=mail.homehelp.rw
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=bookings@homehelp.rw
SMTP_PASS=your_smtp_password
MAIL_FROM_NAME=Home Help Rwanda
MAIL_CONTACT_EMAIL=info@homehelp.rw
MAIL_CONTACT_PHONE="+250 790 533 144"
MAIL_ADDRESS=Kigali, Rwanda

# ── Gmail SMTP fallback (App Password, spaces optional) ──────
SMTP_GMAIL_HOST=smtp.gmail.com
SMTP_GMAIL_PORT=587
SMTP_GMAIL_USER=your-gmail@gmail.com
SMTP_GMAIL_PASS=your_16_char_app_password

# ── Uploads ──────────────────────────────────────────────────
# MAX_UPLOAD_SIZE=5242880
